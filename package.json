{
  "name": "dsh-prts-ui",
  "version": "1.0.0",
  "description": "PRTS — the monochrome GUI shell for dsh (DeepSeek Harness): particle intro, workspaces/sessions with search, mode/model/reasoning/permission selectors, image attachments, approvals & questions, cost + system panels, voice input. Ships one-click installers for Windows/Linux/macOS/Android and the particle download site.",
  "type": "module",
  "main": "./src/plugin-root.js",
  "bin": {
    "dsh-prts-ui": "bin/dsh-prts-ui.js",
    "prts": "bin/dsh-prts-ui.js"
  },
  "exports": {
    ".": "./src/plugin-root.js",
    "./startup": "./src/startup.js",
    "./runner": "./src/runner.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js",
    "./host": "./lib/host.js"
  },
  "files": [
    "bin",
    "src",
    "web",
    "electron",
    "assets",
    "scripts",
    "wizard",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "install.sh",
    "install.bat",
    "prts.config.example.json",
    "lib"
  ],
  "scripts": {
    "bundle": "node scripts/bundle-gui.mjs",
    "scan-market": "node scripts/scan-market.mjs",
    "prepack": "node scripts/bundle-gui.mjs",
    "pack:ui": "pnpm bundle && pnpm pack"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "prts",
    "arknights",
    "chat",
    "tui"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-cmdline": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "electron": "43.4.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}